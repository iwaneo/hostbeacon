# The Agent's root helper (v1 spec §4.1). It has no network code; only the
# hostbeacon user can reach its socket.
[Unit]
Description=Hostbeacon root helper
Documentation=https://github.com/iwaneo/hostbeacon
Before=hostbeacon.service

[Service]
ExecStart=/usr/bin/hostbeacon-helper serve
# The Update run record and the package list refresh time; the network part
# reads them.
StateDirectory=hostbeacon-helper
StateDirectoryMode=0755
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
