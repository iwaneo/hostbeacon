# The Agent's network part (v1 spec §4.1). It runs as the hostbeacon user
# and asks the root helper for everything that needs root.
[Unit]
Description=Hostbeacon Agent
Documentation=https://github.com/iwaneo/hostbeacon
Wants=network-online.target hostbeacon-helper.service
After=network-online.target hostbeacon-helper.service

[Service]
User=hostbeacon
Group=hostbeacon
ExecStart=/usr/bin/hostbeacon serve
NoNewPrivileges=yes
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
