# Refreshes the package list once a day (v1 spec §4.6). Only its timer
# starts it; Home Assistant and the network part cannot.
[Unit]
Description=Hostbeacon package list refresh
Documentation=https://github.com/iwaneo/hostbeacon
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/hostbeacon-helper refresh-package-list
# The stamp with the last refresh time; the network part reads it.
StateDirectory=hostbeacon-helper
StateDirectoryMode=0755
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1h
