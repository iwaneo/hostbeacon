  },
  {
    "name": "null_text",
    "description": "null only where the schema allows it.",
    "frame": "{\"type\": \"unsupported\", \"id\": \"a\", \"kind\": \"reply\", \"reply_to\": \"b\", \"request_type\": null}"
  },
  {
    "name": "null_list",
    "description": "Lists are never null.",
    "frame": "{\"type\": \"delta\", \"id\": \"a\", \"kind\": \"event\", \"groups\": {\"disks\": {\"mounts\": null}}}"
  },
  {
    "name": "null_object",
    "description": "Required objects are never null.",
    "frame": "{\"type\": \"snapshot\", \"id\": \"a\", \"kind\": \"event\", \"groups\": null}"
