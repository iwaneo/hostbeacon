  {
    "name": "bad_kind",
    "description": "kind is request, reply, or event.",
    "frame": "{\"type\": \"delta\", \"id\": \"a\", \"kind\": \"later\", \"groups\": {}}"
  },
  {
    "name": "no_reply_to",
